[Unit]
Description=Arches Instrumentation ota
Documentation=file:///usr/share/doc/instrumentation/interface.md
After=instr-istate.service instr-networkd.service
Wants=instr-istate.service instr-networkd.service
# istate owns orchestration; systemd owns restart policy and sandboxing (§7.1).

[Service]
Type=notify
ExecStart=/usr/bin/instr-ota
Restart=on-failure
RestartSec=2s
# Boot-state capability only (§10).
AmbientCapabilities=CAP_SYS_BOOT
CapabilityBoundingSet=CAP_SYS_BOOT
ReadWritePaths=/pst/state/ota /run/instrumentation /boot
User=instr-ota
Group=instr
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
ProtectHome=read-only
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
