[Unit]
Description=Arches Instrumentation alarms
Documentation=file:///usr/share/doc/instrumentation/interface.md
After=instr-faults.service instr-monitord.service instr-hardware.service
Wants=instr-faults.service
# istate owns orchestration; systemd owns restart policy and sandboxing (§7.1).

[Service]

[Service]
Type=notify
ExecStart=/usr/bin/instr-alarms
Restart=on-failure
RestartSec=2s
ReadWritePaths=/pst/state/alarms /run/instrumentation
User=instr-alarms
Group=instr
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
CapabilityBoundingSet=
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
